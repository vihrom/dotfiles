#!/bin/sh

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"

FILE="$DIR/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"

case "$1" in
    full)
        scrot "$FILE" && xclip -selection clipboard -t image/png -i "$FILE"
        ;;
    select)
        scrot -s "$FILE" && xclip -selection clipboard -t image/png -i "$FILE"
        ;;
esac
