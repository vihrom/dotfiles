#!/bin/sh

# 1. Determine the log range from the last tag to HEAD
last_tag=$(git describe --tags --abbrev=0 2>/dev/null)
[ -z "$last_tag" ] && log_range="HEAD" || log_range="$last_tag..HEAD"

# 2. Analyze commits to determine semantic version bump
commits=$(git log "$log_range" --format="%s" 2>/dev/null)
if echo "$commits" | grep -Eq 'BREAKING CHANGE|!'; then
	bump="major"
elif echo "$commits" | grep -Eq '^feat'; then
	bump="minor"
elif echo "$commits" | grep -Eq '^fix'; then
	bump="patch"
else
	echo "No release-worthy commits found. Skipping."
	exit 0
fi

# 3. Parse current version and calculate the new one
current_version="${last_tag#v}"
[ -z "$current_version" ] && current_version="0.0.0"
IFS='.' read -r major minor patch <<-EOF
$current_version
EOF

case "$bump" in
	major) major=$((major + 1)); minor=0; patch=0 ;;
	minor) minor=$((minor + 1)); patch=0 ;;
	patch) patch=$((patch + 1)) ;;
esac
new_version="v$major.$minor.$patch"

# 4. Generate changelog using native git shortlog
changelog=$(git shortlog "$log_range" --format="* %s (%h)")

# 5. Handle dry-run mode
if [ "$1" = "--dry-run" ] || [ "$1" = "-d" ]; then
	printf -- "--- DRY RUN (%s) ---\n%s\n" "$new_version" "$changelog"
	exit 0
fi

# 6. Create an annotated git tag with the changelog embedded
git tag -a "$new_version" -m "Release $new_version" -m "$changelog"

echo "Release $new_version created! Run 'git push --tags' to publish."
