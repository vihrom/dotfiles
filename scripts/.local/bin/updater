#!/bin/sh

# Configuration
LOG_FILE="$HOME/.cache/updater.log"
export EDITOR="${EDITOR:-vim}"

# Save the absolute starting directory
START_DIR=$(pwd)

# Create log directory if it does not exist
mkdir -p "$(dirname "$LOG_FILE")"

# Target directory is the current directory
TARGET_DIR="."

printf "Searching for Git repositories recursively in: \033[1;35m%s\033[0m...\n" "$START_DIR"

# Find .git directories up to 3 levels deep
repos=$(find "$TARGET_DIR" -maxdepth 3 -name ".git" -type d 2>/dev/null)

if [ -z "$repos" ]; then
    echo "No Git repositories found here."
    exit 0
fi

# Log helper function
log_message() {
    printf "[%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

# Process each found repository
echo "$repos" | while read -r git_dir; do
    [ -z "$git_dir" ] && continue

    repo_path=$(dirname "$git_dir")
    abs_repo_path=$(cd "$repo_path" && pwd)
    repo_name=$(basename "$abs_repo_path")

    printf "\n\033[1;34mChecking %s\033[0m (%s)...\n" "$repo_name" "$abs_repo_path"
    cd "$abs_repo_path" || continue

    # Resolve default branch name from local tracking reference
    default_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed 's|^origin/||')
    default_branch="${default_branch:-master}"

    # Fetch latest changes from upstream
    git fetch origin "$default_branch" >/dev/null 2>&1

    # Compare local HEAD against upstream tracking branch
    LOCAL=$(git rev-parse HEAD 2>/dev/null)
    REMOTE=$(git rev-parse "origin/$default_branch" 2>/dev/null)
    
    if [ "$LOCAL" = "$REMOTE" ] || [ -z "$REMOTE" ]; then
        echo "Up to date."
        cd "$START_DIR" || exit 1
        continue
    fi

    # Updates found, display recent history
    printf "\033[1;33mNew updates available for %s\033[0m\n" "$repo_name"
    echo "New commits upstream:"
    git log "HEAD..origin/$default_branch" --oneline -n 5

    # Interactive prompt via TTY
    printf "Pull updates for %s? [y/N]: " "$repo_name"
    read -r answer < /dev/tty
    
    case "$answer" in
        [Yy]*)
            ;;
        *)
            echo "Skipping..."
            log_message "Skipped update for $repo_name ($abs_repo_path)"
            cd "$START_DIR" || exit 1
            continue
            ;;
    esac

    echo "Updating via rebase..."
    if git rebase "origin/$default_branch"; then
        printf "\033[1;32m%s successfully updated!\033[0m\n" "$repo_name"
        log_message "SUCCESS: Updated $repo_name to $(git rev-parse --short HEAD)"
    else
        printf "\033[1;31mCONFLICT DETECTED in %s\033[0m\n" "$repo_name"
        echo "Opening $EDITOR to resolve conflicts. Fix, save, and close the editor."
        log_message "CONFLICT: Rebase conflict hit in $repo_name"
        
        conflicted_files=$(git diff --name-only --diff-filter=U)
        if [ -n "$conflicted_files" ]; then
            $EDITOR $conflicted_files
        fi

        echo "Attempting to finish rebase..."
        git add .
        if git rebase --continue; then
            printf "\033[1;32mConflicts resolved! %s updated.\033[0m\n" "$repo_name"
            log_message "SUCCESS: Resolved conflicts and updated $repo_name"
        else
            echo "Rebase failed again. Rolling back to safe state..."
            git rebase --abort
            echo "Skipped $repo_name to prevent breaking your code."
            log_message "FAILED: Rebase aborted for $repo_name due to unresolved conflicts"
        fi
    fi

    # Return to the initial search path
    cd "$START_DIR" || exit 1
done

printf "\nDone! Logs saved to \033[1;36m%s\033[0m\n" "$LOG_FILE"
