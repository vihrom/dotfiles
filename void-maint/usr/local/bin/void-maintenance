#!/bin/sh
# Void Linux System Maintenance: Upgrade & Clean

LOG_FILE="/var/log/void-maintenance.log"

# Set strict safe PATH for system utilities
export PATH="/usr/bin:/usr/sbin:/bin:/sbin"

# Log helper to capture current timestamp without spawning multiple date forks
log_task() {
	printf "[%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

log_task "STARTING WEEKLY SYSTEM MAINTENANCE"

# Measure disk space using portable POSIX format (-P) to ensure 4th column is always Available space
SPACE_BEFORE=$(df -P / | awk 'NR==2 {print $4}')
TMP_UPGRADE_LOG=$(mktemp)

# 1. System Upgrade
echo "  [XBPS] Syncing repositories and upgrading packages..." >> "$LOG_FILE"
if xbps-install -Suy > "$TMP_UPGRADE_LOG" 2>&1; then
	if grep -Eq "configured|installed|unpacked" "$TMP_UPGRADE_LOG"; then
		log_task "SUCCESS: System upgrade completed. Packages updated:"
		grep -E "configured|installed|unpacked" "$TMP_UPGRADE_LOG" >> "$LOG_FILE"
	else
		log_task "SUCCESS: System upgrade completed. No new updates available."
	fi
else
	log_task "ERROR: Error occurred during system upgrade."
	cat "$TMP_UPGRADE_LOG" >> "$LOG_FILE"
fi
rm -f "$TMP_UPGRADE_LOG"

# 2. Clean old packages and orphans
echo "  [XBPS] Removing obsolete cached packages and orphans..." >> "$LOG_FILE"
if xbps-remove -Ooy >> "$LOG_FILE" 2>&1; then
	log_task "SUCCESS: XBPS cache and orphans cleared."
else
	log_task "ERROR: Error occurred during XBPS cleanup."
fi

# 3. Clean old kernels
echo "  [KERNEL] Purging unused Linux kernels..." >> "$LOG_FILE"
if vkpurge rm all >> "$LOG_FILE" 2>&1; then
	log_task "SUCCESS: Old kernels purged."
else
	log_task "ERROR: Error occurred during kernel purge."
fi

# Calculate total space saved
SPACE_AFTER=$(df -P / | awk 'NR==2 {print $4}')
FREED_MB=$(( (SPACE_AFTER - SPACE_BEFORE) / 1024 ))

log_task "Maintenance tasks finished!"
printf "SUMMARY: Disk space delta: %d MB.\n" "$FREED_MB" >> "$LOG_FILE"
echo "--------------------------------------------------" >> "$LOG_FILE"
